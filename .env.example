# ============================================
# Configuracion de MCP AnythingLLM
# ============================================
# Copia este archivo a `.env` y rellena los valores reales.

# URL del servidor local de AnythingLLM
ANYTHINGLLM_URL=http://localhost:3001

# API key de AnythingLLM
# Obtener en: AnythingLLM -> Settings -> Tools -> Developer API
ANYTHINGLLM_API_KEY=tu-api-key-aqui
